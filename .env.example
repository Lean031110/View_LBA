# ============================================================
# ViewLBA — Variables de entorno (copiar a .env y editar)
# ============================================================
# ⚠ OBLIGATORIAS en producción: el servidor NO ARRANCA si faltan
#    o si son placeholders (validación Zod en src/lib/env.ts).
# Generar secretos:  openssl rand -hex 24 / openssl rand -hex 16
# NUNCA commitear este archivo con valores reales.
#
# Los instaladores de producción ya lo generan todo:
#   Linux:   deploy/linux/install.sh   (/etc/pantalla-restaurante.env)
#   Windows: deploy/windows/install.ps1 (C:\PantallaRestaurante\app\.env)

# --- Obligatorias ---------------------------------------------------

# Secreto para firmar las sesiones de administración (>= 24 chars).
AUTH_SECRET="generar-con-openssl-rand-hex-24"

# Token interno de comunicación Next.js ↔ realtime-service (>= 16 chars).
REALTIME_TOKEN="generar-con-openssl-rand-hex-16"

# Base de datos SQLite.
# ⚠ RUTA ABSOLUTA RECOMENDADA: las rutas relativas de file: se resuelven
#   contra el CWD de cada proceso (prisma CLI / server / mini-services),
#   NO contra prisma/schema.prisma — un absoluto elimina toda ambigüedad.
#   Los instaladores (scripts/install.ts, deploy/*) siempre generan absolutas.
DATABASE_URL="file:/ruta/absoluta/al/proyecto/db/custom.db"

# --- App --------------------------------------------------------------

# Puerto de la app Next.js (default 3000).
# PORT=3000

# Timezone por defecto del restaurante si la DB aún no tiene ajustes
# (la fuente real es Settings.timezone en el panel).
# TIMEZONE=America/Havana

# --- Almacenamiento separado (FASE 11; defaults = rutas relativas al
#     proyecto si no se definen; en producción se recomienda separar) --
# MEDIA_DIR="/var/lib/pantalla-restaurante/media"
# BACKUP_DIR="/var/lib/pantalla-restaurante/backups"
# LOG_DIR="/var/log/pantalla-restaurante"
# DATA_DIR="/var/lib/pantalla-restaurante/data"

# --- Seguridad ----------------------------------------------------------

# Límite de intentos de login por IP en 5 minutos (default 12).
# Súbelo SOLO con justificación (p. ej. E2E/CI abre muchas sesiones).
# LOGIN_RATE_LIMIT_IP_MAX=12

# SVG en uploads: deshabilitado por defecto (XSS same-origin). Activar SOLO
# con sanitización externa previa (FASE 10).
# ALLOW_SVG=false

# Orígenes permitidos para el websocket realtime (CORS), separados por coma.
# Vacío = se infiere del host de la app. NUNCA usar "*" en producción.
# ALLOWED_ORIGINS="http://192.168.1.50:3000"

# Hosts/IPs que /api/admin/stream-test puede comprobar desde el servidor
# (protección SSRF; vacío = solo hosts públicos, sin IPs internas).
# STREAM_TEST_ALLOWED_HOSTS="192.168.1.50,rtmp.mi-servidor.local"

# Cuota total de medios subidos en MB (FASE 10).
# MEDIA_MAX_TOTAL_MB=2048

# --- Realtime-service (mini-servicio Socket.io) -------------------------
# REALTIME_PORT=3003           # websocket (pantallas/admins — LAN)
# REALTIME_INTERNAL_PORT=3004  # API interna (localhost: health/status/broadcast)

# --- Stream-service (mini-servicio RTMP/FLV) ----------------------------
# RTMP_PORT=1935        # ingest OBS
# HTTP_FLV_PORT=8000    # FLV interno (solo localhost)
# HTTP_FLV_BIND=127.0.0.1  # 0.0.0.0 SOLO si hay clientes FLV directos en la red

# --- Auditoría y backups -------------------------------------------------
# Retención de la auditoría (tabla Log) en días (default 90).
# Purga: bun scripts/logs-purge.ts (programada por systemd/tarea programada).
# LOG_RETENTION_DAYS=90

# Backups a conservar en BACKUP_DIR (default 14; FASE 16).
# BACKUP_RETENTION=14

# --- Health (rutas internas; default ya correcto) -----------------------
# REALTIME_HEALTH_URL=http://127.0.0.1:3004/health
# STREAM_HEALTH_URL=http://127.0.0.1:8100/health

# --- Licenciamiento v2 (token copiar/pegar, offline) ----------------------
# Clave PÚBLICA Ed25519 que verifica los tokens VLBA2. La de producción ya
# viene incrustada (src/lib/licensing/public-key.ts); esta variable es para
# TESTS/rotación. NUNCA pongas aquí una clave privada.
# VIEWLBA_LICENSE_PUBLIC_KEY=""
#
# Clave PÚBLICA X25519 hacia la que se sellan los códigos de solicitud
# VLREQ2 (solo la app Android del emisor puede abrirlos). La de producción
# viene incrustada; variable para TESTS/rotación.
# VIEWLBA_REQUEST_PUBLIC_KEY=""
#
# Ventana de gracia tras el vencimiento de una licencia, en horas
# (default 0 = deshabilitada). Opcional, solo si el negocio lo decide.
# LICENSE_GRACE_HOURS=0
