# ============================================================
# ViewLBA — Variables de entorno (copiar a .env y editar)
# ============================================================

# Base de datos SQLite.
# Ruta relativa a prisma/schema.prisma (prisma/ → raíz del proyecto)
DATABASE_URL="file:../db/custom.db"

# Secreto para firmar las sesiones de administración.
# Generar uno largo y aleatorio:  openssl rand -hex 24
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Token interno de comunicación entre la app Next.js y el
# mini-servicio realtime (no exponer):  openssl rand -hex 16
REALTIME_TOKEN="cambiar-por-otro-secreto-aleatorio"

# --- Opcional: puertos del servidor de streaming integrado ---
# RTMP_PORT=1935        # ingest OBS
# HTTP_FLV_PORT=8000    # FLV interno (solo localhost)
