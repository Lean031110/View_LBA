<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:backgroundTint="@color/bg"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/new_license_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/new_license_title"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/request_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/request_code_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="3"
            android:maxLines="5"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:backgroundTint="@color/surface_alt" />

        <Button
            android:id="@+id/btn_validate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_validate"
            android:backgroundTint="@color/surface_alt"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/req_customer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/req_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/issue_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_title"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <RadioGroup
                android:id="@+id/plan_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/plan_monthly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_monthly"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/plan_annual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/plan_annual"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/plan_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/plan_custom"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <EditText
                android:id="@+id/custom_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/custom_days_hint"
                android:inputType="number"
                android:visibility="gone"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <CheckBox
                android:id="@+id/allow_shorten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/allow_shorten"
                android:textColor="@color/error"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_generate"
                android:backgroundTint="@color/accent"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/new_license_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="13sp"
            android:textColor="@color/ok"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:id="@+id/result_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/token_result_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/token_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="4"
            android:maxLines="8"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_copy_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_copy_token"
            android:backgroundTint="@color/surface_alt"
            android:textColor="@color/text_primary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
