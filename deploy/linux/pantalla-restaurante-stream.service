[Unit]
Description=Pantalla Restaurante - Servicio de streaming (RTMP/HTTP-FLV, OBS)
Documentation=file:/opt/pantalla-restaurante/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target
PartOf=pantalla-restaurante.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pantalla
Group=pantalla
# WorkingDirectory en /var/lib: el almacen de NMS (./data) queda en el
# directorio de DATOS, no dentro del codigo (se sobreescribe en upgrades)
WorkingDirectory=/var/lib/pantalla-restaurante
EnvironmentFile=/etc/pantalla-restaurante.env
ExecStart=__BUN_BIN__ /opt/pantalla-restaurante/mini-services/stream-service/index.ts

Restart=always
RestartSec=5

# RTMP + FLV pueden usar mas memoria con GOP cache y varios viewers
MemoryMax=768M
CPUQuota=200%
LimitNOFILE=16384

# Endurecimiento
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/pantalla-restaurante /var/log/pantalla-restaurante

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pantalla-stream

[Install]
WantedBy=multi-user.target
