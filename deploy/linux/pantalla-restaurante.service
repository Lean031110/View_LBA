[Unit]
Description=Pantalla Restaurante - Aplicacion Next.js (senalizacion digital)
Documentation=file:/opt/pantalla-restaurante/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target
PartOf=pantalla-restaurante.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pantalla
Group=pantalla
WorkingDirectory=/opt/pantalla-restaurante
EnvironmentFile=/etc/pantalla-restaurante.env
Environment=NODE_ENV=production
# Build standalone (bun run build) — servidor autocontenido, sin next dev
ExecStart=__BUN_BIN__ /opt/pantalla-restaurante/.next/standalone/server.js

# Reinicio automatico (24/7): caida -> arriba en 5s
Restart=always
RestartSec=5

# Limites razonables (TV 24/7: la app sirve contenido + API)
MemoryMax=1G
CPUQuota=200%
LimitNOFILE=16384

# Endurecimiento: nada de root, FS lo mas readonly posible
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/pantalla-restaurante /var/log/pantalla-restaurante

# Logs -> journald (journalctl -u pantalla-restaurante) + el logger
# estructurado escribe ademas en LOG_DIR (rotativo por tamano)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pantalla-restaurante

[Install]
WantedBy=multi-user.target
