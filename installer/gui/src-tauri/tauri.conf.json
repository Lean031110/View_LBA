{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViewLBA Server",
  "version": "1.0.0",
  "identifier": "com.viewlba.server",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ViewLBA Server — Installer & Manager",
        "width": 960,
        "height": 700,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/viewlba-installer"],
    "resources": ["resources/server/**", "resources/runtime/**"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SpanishInternational", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstall": { "mode": "downloadBootstrapper" }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
