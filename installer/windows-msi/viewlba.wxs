<?xml version="1.0" encoding="UTF-8"?>
<!--
  ViewLBA Server — WiX v4 MSI Installer (mission §3, §6, §7, §31)
  ====================================================================
  CANONICAL Windows installer. Uses WiX-native ServiceInstall +
  ServiceControl (NOT CustomAction with viewlba-service.exe --install).
  The MSI is the SINGLE authority for service registration.

  Routes:
    Program Files\ViewLBA Server\     → bin/, runtime/, app/, mini-services/, themes/, public/
    ProgramData\ViewLBA\              → config/, data/{db,media,backups,store}, logs/, credentials/, run/, cache/

  ACL Matrix (mission §4 — minimum privilege for LocalService):
    | Ruta          | SYSTEM | Administrators | LocalService      | Users |
    |---------------|--------|----------------|-------------------|-------|
    | config        | full   | full           | read (NO write)   | (none)|
    | data/db       | full   | full           | read+write        | (none)|
    | data/media    | full   | full           | read+write        | (none)|
    | data/backups  | full   | full           | read+write        | (none)|
    | data/store    | full   | full           | read+write        | (none)|
    | logs          | full   | full           | read+write        | read  |
    | credentials   | full   | full           | (NONE)            | (none)|
    | run           | full   | full           | read+write        | (none)|
    | cache         | full   | full           | read+write        | (none)|

  Uninstall: stops service via ServiceControl, removes Program Files,
  CONSERVES ProgramData (DB, media, backups, config, secrets).

  Build:
    wix build installer/windows-msi/viewlba.wxs \
         -o dist/release/windows/out/ViewLBA-Server-Setup-$(var.VERSION).msi \
         -d VERSION=$(var.VERSION) \
         -d BUILD_DIR=$(var.BUILD_DIR) \
         -d PAYLOAD_DIR=$(var.PAYLOAD_DIR) \
         -d UPGRADE_CODE=$(var.UPGRADE_CODE)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ViewLBA Server $(var.VERSION)"
           Manufacturer="ViewLBA"
           Version="$(var.VERSION)"
           Language="3082"
           Codepage="1252"
           InstallerVersion="500"
           UpgradeCode="$(var.UPGRADE_CODE)">

    <SummaryInformation Codepage="1252"
                        Description="ViewLBA Server $(var.VERSION) - Installer"
                        Manufacturer="ViewLBA"
                        Keywords="ViewLBA,Signage,Restaurant,Installer" />

    <!-- Major upgrade support: vA to vB upgrades cleanly (mission §J.1) -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ViewLBA Server is already installed. The installer will now exit."
                  Schedule="afterInstallInitialize"
                  AllowSameVersion="no"
                  Disallow="no" />

    <Media Id="1" Cabinet="viewlba.cab" EmbedCab="yes" />

    <!-- Properties -->
    <Property Id="VIEWLBA_PROGRAM_FILES" Value="[ProgramFiles64Folder]ViewLBA Server" />
    <Property Id="VIEWLBA_PROGRAM_DATA" Value="[CommonAppDataFolder]ViewLBA" Secure="yes" />
    <Property Id="VIEWLBA_PANEL_URL" Value="http://localhost:3000" />

    <!-- ARP properties (mission §J.3) -->
    <Property Id="ARPINSTALLLOCATION" Value="[VIEWLBA_PROGRAM_FILES]" />
    <Property Id="ARPDISPLAYNAME" Value="ViewLBA Server $(var.VERSION)" />
    <Property Id="ARPCOMMENTS" Value="ViewLBA Server - digital signage for restaurants" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Lean031110/View_LBA" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="0" />
    <Property Id="ARPCONTACT" Value="ViewLBA" />

    <!-- Directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VIEWLBA_PROGRAM_FILES_DIR" Name="ViewLB~1" LongName="ViewLBA Server">
        <Directory Id="BIN_DIR" Name="bin" />
        <Directory Id="RUNTIME_DIR" Name="runtime" />
        <Directory Id="APP_DIR" Name="app" />
        <Directory Id="MINI_SERVICES_DIR" Name="MINISE~1" LongName="mini-services" />
        <Directory Id="THEMES_PF_DIR" Name="themes" />
        <Directory Id="PUBLIC_DIR" Name="public" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VIEWLBA_PROGRAM_DATA_DIR" Name="ViewLBA">
        <Directory Id="CONFIG_DIR" Name="config" />
        <Directory Id="DATA_DIR" Name="data">
          <Directory Id="DB_DIR" Name="db" />
          <Directory Id="MEDIA_DIR" Name="media" />
          <Directory Id="BACKUPS_DIR" Name="backups" />
          <Directory Id="STORE_DIR" Name="store" />
        </Directory>
        <Directory Id="LOGS_DIR" Name="logs" />
        <Directory Id="CREDENTIALS_DIR" Name="credentials" />
        <Directory Id="RUN_DIR" Name="run" />
        <Directory Id="CACHE_DIR" Name="cache" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="VIEWLBA_SHORTCUTS_DIR" Name="ViewLB~1" LongName="ViewLBA Server" />
    </StandardDirectory>
    <Directory Id="DesktopFolder" />

    <!-- ================================================================
         Components: Program Files (binaries)
         ================================================================ -->

    <!-- viewlba-service.exe + ServiceInstall (WiX native — mission J.4) -->
    <DirectoryRef Id="BIN_DIR">
      <Component Id="cmp_viewlba_service_exe" Guid="*">
        <File Id="file_viewlba_service_exe" Source="$(var.BUILD_DIR)\viewlba-service.exe" KeyPath="yes" />

        <!-- WiX-native service registration (NOT CustomAction --install) -->
        <ServiceInstall Name="ViewLBA"
                        DisplayName="ViewLBA Server"
                        Description="ViewLBA Server - native host for App + Realtime + Stream children"
                        Type="ownProcess"
                        Start="auto"
                        Account="NT AUTHORITY\LocalService"
                        ErrorControl="normal"
                        Vital="yes" />

        <!-- Stop on uninstall, remove on uninstall -->
        <ServiceControl Name="ViewLBA"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- viewlba-tray.exe + autostart (HKCU Run — per user, NOT HKLM) -->
      <Component Id="cmp_viewlba_tray_exe" Guid="*">
        <File Id="file_viewlba_tray_exe" Source="$(var.BUILD_DIR)\viewlba-tray.exe" KeyPath="yes" />
        <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Name="ViewLBATray"
                         Value="&quot;[BIN_DIR]viewlba-tray.exe&quot;"
                         Type="string" />
        </RegistryKey>
      </Component>

      <!-- viewlba-installer.exe (TS sidecar for DB/.env/admin setup) -->
      <Component Id="cmp_viewlba_installer_exe" Guid="*">
        <File Id="file_viewlba_installer_exe" Source="$(var.BUILD_DIR)\viewlba-installer.exe" KeyPath="yes" />
      </Component>

      <!-- Product icon -->
      <Component Id="cmp_viewlba_ico" Guid="*">
        <File Id="file_viewlba_ico" Source="$(var.BUILD_DIR)\viewlba.ico" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Runtime (bun.exe) -->
    <DirectoryRef Id="RUNTIME_DIR">
      <Component Id="cmp_runtime_bun_exe" Guid="*">
        <File Id="file_runtime_bun_exe" Source="$(var.PAYLOAD_DIR)\runtime\bun.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- App (Next.js standalone) -->
    <DirectoryRef Id="APP_DIR">
      <Component Id="cmp_app_server_js" Guid="*">
        <File Id="file_app_server_js" Source="$(var.PAYLOAD_DIR)\app\server.js" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Mini-services -->
    <DirectoryRef Id="MINI_SERVICES_DIR">
      <Component Id="cmp_realtime_index" Guid="*">
        <File Id="file_realtime_index" Source="$(var.PAYLOAD_DIR)\mini-services\realtime-service\index.ts" KeyPath="yes" />
      </Component>
      <Component Id="cmp_stream_index" Guid="*">
        <File Id="file_stream_index" Source="$(var.PAYLOAD_DIR)\mini-services\stream-service\index.ts" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================
         Components: ProgramData (ACL matrix — mission B)
         ================================================================ -->

    <!-- config/ — LocalService: read ONLY (no write) -->
    <DirectoryRef Id="CONFIG_DIR">
      <Component Id="cmp_config_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- data/db/ — LocalService: read + write -->
    <DirectoryRef Id="DB_DIR">
      <Component Id="cmp_db_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- data/media/ — LocalService: read + write -->
    <DirectoryRef Id="MEDIA_DIR">
      <Component Id="cmp_media_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- data/backups/ — LocalService: read + write -->
    <DirectoryRef Id="BACKUPS_DIR">
      <Component Id="cmp_backups_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- data/store/ — LocalService: read + write -->
    <DirectoryRef Id="STORE_DIR">
      <Component Id="cmp_store_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- logs/ — LocalService: read + write, Users: read -->
    <DirectoryRef Id="LOGS_DIR">
      <Component Id="cmp_logs_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
          <Permission User="Users" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- credentials/ — SYSTEM + Administrators ONLY (NO LocalService) -->
    <DirectoryRef Id="CREDENTIALS_DIR">
      <Component Id="cmp_credentials_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- run/ — LocalService: read + write (PID files, IPC markers) -->
    <DirectoryRef Id="RUN_DIR">
      <Component Id="cmp_run_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- cache/ — LocalService: read + write -->
    <DirectoryRef Id="CACHE_DIR">
      <Component Id="cmp_cache_dir" Guid="*" KeyPath="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="NT AUTHORITY\LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- ================================================================
         Registry: InstallDir lookup (for upgrades + tray to find install)
         ================================================================ -->
    <Component Id="cmp_registry_root" Guid="*" Directory="TARGETDIR">
      <RegistryKey Root="HKLM" Key="SOFTWARE\ViewLBA" ForceCreateOnInstall="yes">
        <RegistryValue Name="InstallDir" Value="[BIN_DIR]" Type="string" />
        <RegistryValue Name="AppDir" Value="[APP_DIR]" Type="string" />
        <RegistryValue Name="DataDir" Value="[VIEWLBA_PROGRAM_DATA_DIR]" Type="string" />
        <RegistryValue Name="LogDir" Value="[LOGS_DIR]" Type="string" />
        <RegistryValue Name="Version" Value="$(var.VERSION)" Type="string" />
      </RegistryKey>
    </Component>

    <!-- ================================================================
         Shortcuts: Start Menu (mission J.4)
         ================================================================ -->
    <DirectoryRef Id="VIEWLBA_SHORTCUTS_DIR">
      <Component Id="cmp_shortcut_panel" Guid="*">
        <Shortcut Id="sc_panel"
                  Name="ViewLBA Panel"
                  Target="[WindowsFolder]explorer.exe"
                  Arguments="$(var.VIEWLBA_PANEL_URL)"
                  Directory="VIEWLBA_SHORTCUTS_DIR"
                  Icon="viewlba.ico"
                  WorkingDirectory="BIN_DIR" />
        <RegistryValue Root="HKCU" Key="Software\ViewLBA\Shortcuts" Name="Panel" Value="[VIEWLBA_SHORTCUTS_DIR]ViewLBA Panel.lnk" Type="string" KeyPath="yes" />
      </Component>

      <Component Id="cmp_shortcut_tray" Guid="*">
        <Shortcut Id="sc_tray"
                  Name="ViewLBA Bandeja"
                  Target="[BIN_DIR]viewlba-tray.exe"
                  Directory="VIEWLBA_SHORTCUTS_DIR"
                  Icon="viewlba.ico"
                  WorkingDirectory="BIN_DIR" />
        <RegistryValue Root="HKCU" Key="Software\ViewLBA\Shortcuts" Name="Tray" Value="[VIEWLBA_SHORTCUTS_DIR]ViewLBA Bandeja.lnk" Type="string" KeyPath="yes" />
      </Component>

      <Component Id="cmp_shortcut_credentials" Guid="*">
        <Shortcut Id="sc_credentials"
                  Name="ViewLBA Credenciales"
                  Target="[WindowsFolder]System32\notepad.exe"
                  Arguments="[CREDENTIALS_DIR]CREDENCIALES.txt"
                  Directory="VIEWLBA_SHORTCUTS_DIR"
                  Icon="viewlba.ico" />
        <RegistryValue Root="HKCU" Key="Software\ViewLBA\Shortcuts" Name="Credentials" Value="[VIEWLBA_SHORTCUTS_DIR]ViewLBA Credenciales.lnk" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcuts -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="cmp_desktop_panel" Guid="*">
        <Shortcut Id="sc_desktop_panel"
                  Name="ViewLBA Panel"
                  Target="[WindowsFolder]explorer.exe"
                  Arguments="$(var.VIEWLBA_PANEL_URL)"
                  Directory="DesktopFolder"
                  Icon="viewlba.ico"
                  WorkingDirectory="BIN_DIR" />
        <RegistryValue Root="HKCU" Key="Software\ViewLBA\Shortcuts" Name="DesktopPanel" Value="[DesktopFolder]ViewLBA Panel.lnk" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Icon reference -->
    <Icon Id="viewlba.ico" SourceFile="$(var.BUILD_DIR)\viewlba.ico" />

    <!-- ================================================================
         ARP entry (mission J.3)
         ================================================================ -->
    <Component Id="cmp_arp" Guid="*" Directory="TARGETDIR">
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\ViewLBA">
        <RegistryValue Name="DisplayName" Value="ViewLBA Server $(var.VERSION)" Type="string" />
        <RegistryValue Name="DisplayVersion" Value="$(var.VERSION)" Type="string" />
        <RegistryValue Name="Publisher" Value="ViewLBA" Type="string" />
        <RegistryValue Name="InstallLocation" Value="[VIEWLBA_PROGRAM_FILES]" Type="string" />
        <RegistryValue Name="UninstallString" Value="[System64Folder]msiexec.exe /x [ProductCode]" Type="string" />
        <RegistryValue Name="DisplayIcon" Value="[BIN_DIR]viewlba-service.exe" Type="string" />
        <RegistryValue Name="NoModify" Value="1" Type="integer" />
        <RegistryValue Name="NoRepair" Value="1" Type="integer" />
        <RegistryValue Name="URLInfoAbout" Value="https://github.com/Lean031110/View_LBA" Type="string" />
      </RegistryKey>
    </Component>

    <!-- ================================================================
         Features
         ================================================================ -->
    <Feature Id="ProductFeature" Title="ViewLBA Server" Level="1"
             Description="ViewLBA Server - signage for restaurants."
             Display="expand" AllowAbsent="no">
      <ComponentRef Id="cmp_viewlba_service_exe" />
      <ComponentRef Id="cmp_viewlba_tray_exe" />
      <ComponentRef Id="cmp_viewlba_installer_exe" />
      <ComponentRef Id="cmp_viewlba_ico" />
      <ComponentRef Id="cmp_runtime_bun_exe" />
      <ComponentRef Id="cmp_app_server_js" />
      <ComponentRef Id="cmp_realtime_index" />
      <ComponentRef Id="cmp_stream_index" />
      <ComponentRef Id="cmp_config_dir" />
      <ComponentRef Id="cmp_db_dir" />
      <ComponentRef Id="cmp_media_dir" />
      <ComponentRef Id="cmp_backups_dir" />
      <ComponentRef Id="cmp_store_dir" />
      <ComponentRef Id="cmp_logs_dir" />
      <ComponentRef Id="cmp_credentials_dir" />
      <ComponentRef Id="cmp_run_dir" />
      <ComponentRef Id="cmp_cache_dir" />
      <ComponentRef Id="cmp_registry_root" />
      <ComponentRef Id="cmp_shortcut_panel" />
      <ComponentRef Id="cmp_shortcut_tray" />
      <ComponentRef Id="cmp_shortcut_credentials" />
      <ComponentRef Id="cmp_desktop_panel" />
      <ComponentRef Id="cmp_arp" />
    </Feature>

    <!-- ================================================================
         Install sequence — ServiceInstall handles service registration
         No CustomAction needed for --install/--uninstall
         ================================================================ -->
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>

  </Package>
</Wix>
