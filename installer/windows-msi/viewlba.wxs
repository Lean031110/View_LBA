<?xml version="1.0" encoding="UTF-8"?>
<!--
  ViewLBA Server — WiX v4 MSI Installer (mission §3, §6, §7, §31)
  ====================================================================
  Canonical Windows installer. NSIS (viewlba-setup.nsi) becomes optional
  bootstrapper only — MSI is the source of truth.

  Routes:
    Program Files\ViewLBA Server\     → bin/, runtime/, app/, mini-services/, themes/, public/
    ProgramData\ViewLBA\              → config/, data/{db,media,backups,store}, logs/, credentials/, run/, cache/

  Service registration: ViewLBA (single SCM entry, host supervises 3 children)
  ARP entry: yes ( DisplayName, Version, Publisher, InstallLocation, UninstallString, DisplayIcon, NoModify=1, NoRepair=1 )
  Major upgrade: yes (allow v3.x to v3.y without uninstall)
  Service interaction: MSI handles ServiceInstall + ServiceControl on install/uninstall

  Build:
    wix build installer/windows-msi/viewlba.wxs \
         -ext WixToolset.UI.wixext \
         -o dist/release/windows/ViewLBA-Server-Setup-3.3.0.msi \
         -d VERSION=3.3.0 \
         -d UPGRADE_CODE=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX \
         -d BUILD_DIR=dist/release/windows/stage \
         -d PAYLOAD_DIR=dist/release/windows/ViewLBA-Server

  This file is the source of truth for the Windows installer. Tests verify
  that the produced MSI:
    - Installs to Program Files (NOT C:\ViewLBA, NOT C:\PantallaRestaurante)
    - Creates ProgramData structure with proper ACLs
    - Registers ARP entry (visible in Add/Remove Programs)
    - Registers ViewLBA service with SCM (via custom action)
    - Supports upgrade (MajorUpgrade element)
    - Does NOT delete ProgramData on uninstall (data preservation)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ViewLBA Server $(var.VERSION)"
           Manufacturer="ViewLBA"
           Version="$(var.VERSION)"
           Language="3082"
           Codepage="1252"
           InstallerVersion="500">

    <SummaryInformation Codepage="1252"
                        Description="ViewLBA Server $(var.VERSION) - Installer"
                        Manufacturer="ViewLBA"
                        Keywords="ViewLBA,Signage,Restaurant,Installer" />

    <!-- Major upgrade support: v3.x to v3.y upgrades cleanly -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ViewLBA Server is already installed. The installer will now exit."
                  Schedule="afterInstallInitialize"
                  AllowSameVersion="no"
                  Disallow="no" />

    <Media Id="1" Cabinet="viewlba.cab" EmbedCab="yes" />

    <!-- Properties -->
    <Property Id="VIEWLBA_PROGRAM_FILES" Value="[ProgramFiles64Folder]ViewLBA Server" />
    <Property Id="VIEWLBA_PROGRAM_DATA" Value="[CommonAppDataFolder]ViewLBA" Secure="yes" />
    <Property Id="VIEWLBA_PANEL_URL" Value="http://localhost:3000" />

    <!-- ARP properties -->
    <Property Id="ARPINSTALLLOCATION" Value="[VIEWLBA_PROGRAM_FILES]" />
    <Property Id="ARPDISPLAYNAME" Value="ViewLBA Server $(var.VERSION)" />
    <Property Id="ARPCOMMENTS" Value="ViewLBA Server - digital signage for restaurants" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Lean031110/View_LBA" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VIEWLBA_PROGRAM_FILES_DIR" Name="ViewLB~1" LongName="ViewLBA Server">
        <Directory Id="BIN_DIR" Name="bin" />
        <Directory Id="RUNTIME_DIR" Name="runtime" />
        <Directory Id="APP_DIR" Name="app" />
        <Directory Id="MINI_SERVICES_DIR" Name="MINISE~1" LongName="mini-services" />
        <Directory Id="THEMES_PF_DIR" Name="themes" />
        <Directory Id="PUBLIC_DIR" Name="public" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VIEWLBA_PROGRAM_DATA_DIR" Name="ViewLBA">
        <Directory Id="CONFIG_DIR" Name="config" />
        <Directory Id="DATA_DIR" Name="data">
          <Directory Id="DB_DIR" Name="db" />
          <Directory Id="MEDIA_DIR" Name="media" />
          <Directory Id="BACKUPS_DIR" Name="backups" />
          <Directory Id="STORE_DIR" Name="store" />
        </Directory>
        <Directory Id="LOGS_DIR" Name="logs" />
        <Directory Id="CREDENTIALS_DIR" Name="credentials" />
        <Directory Id="RUN_DIR" Name="run" />
        <Directory Id="CACHE_DIR" Name="cache" />
      </Directory>
    </StandardDirectory>

    <!-- Components: Program Files (binaries) -->
    <DirectoryRef Id="BIN_DIR">
      <Component Id="cmp_viewlba_service_exe" Guid="*">
        <File Id="file_viewlba_service_exe" Source="$(var.BUILD_DIR)\viewlba-service.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_viewlba_tray_exe" Guid="*">
        <File Id="file_viewlba_tray_exe" Source="$(var.BUILD_DIR)\viewlba-tray.exe" KeyPath="yes" />
        <!-- Tray autostart -->
        <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Name="ViewLBATray" Value="&quot;[BIN_DIR]viewlba-tray.exe&quot;" Type="string" />
        </RegistryKey>
      </Component>
      <Component Id="cmp_viewlba_installer_exe" Guid="*">
        <File Id="file_viewlba_installer_exe" Source="$(var.BUILD_DIR)\viewlba-installer.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_viewlba_ico" Guid="*">
        <File Id="file_viewlba_ico" Source="$(var.BUILD_DIR)\viewlba.ico" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="RUNTIME_DIR">
      <Component Id="cmp_runtime_bun_exe" Guid="*">
        <File Id="file_runtime_bun_exe" Source="$(var.PAYLOAD_DIR)\runtime\bun.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="APP_DIR">
      <Component Id="cmp_app_server_js" Guid="*">
        <File Id="file_app_server_js" Source="$(var.PAYLOAD_DIR)\app\server.js" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Components: ProgramData (folders with ACLs) -->
    <DirectoryRef Id="CONFIG_DIR">
      <Component Id="cmp_config_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DB_DIR">
      <Component Id="cmp_db_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="MEDIA_DIR">
      <Component Id="cmp_media_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="BACKUPS_DIR">
      <Component Id="cmp_backups_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="LOGS_DIR">
      <Component Id="cmp_logs_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Users" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="CREDENTIALS_DIR">
      <Component Id="cmp_credentials_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="RUN_DIR">
      <Component Id="cmp_run_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="CACHE_DIR">
      <Component Id="cmp_cache_dir" Guid="*">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- Registry: InstallDir lookup (for upgrades + tray to find install) -->
    <Component Id="cmp_registry_root" Guid="*" Directory="TARGETDIR">
      <RegistryKey Root="HKLM" Key="SOFTWARE\ViewLBA" ForceCreateOnInstall="yes">
        <RegistryValue Name="InstallDir" Value="[BIN_DIR]" Type="string" />
        <RegistryValue Name="AppDir" Value="[APP_DIR]" Type="string" />
        <RegistryValue Name="DataDir" Value="[VIEWLBA_PROGRAM_DATA_DIR]" Type="string" />
        <RegistryValue Name="LogDir" Value="[LOGS_DIR]" Type="string" />
        <RegistryValue Name="Version" Value="$(var.VERSION)" Type="string" />
      </RegistryKey>
    </Component>

    <!-- Custom actions: register/unregister service via the host binary itself
         (avoids NSSM and avoids WiX ServiceInstall quirks with --run arg) -->
    <Binary Id="bin_viewlba_service_exe" SourceFile="$(var.BUILD_DIR)\viewlba-service.exe" />

    <CustomAction Id="ca_register_service"
                  BinaryRef="bin_viewlba_service_exe"
                  ExeCommand="--install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="ca_unregister_service"
                  BinaryRef="bin_viewlba_service_exe"
                  ExeCommand="--uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Start service after install -->
    <CustomAction Id="ca_start_service"
                  BinaryRef="bin_viewlba_service_exe"
                  ExeCommand="--start"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Stop service before uninstall -->
    <CustomAction Id="ca_stop_service"
                  BinaryRef="bin_viewlba_service_exe"
                  ExeCommand="--stop"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Features -->
    <Feature Id="ProductFeature" Title="ViewLBA Server" Level="1"
             Description="ViewLBA Server - signage for restaurants."
             Display="expand" AllowAbsent="no">
      <ComponentRef Id="cmp_viewlba_service_exe" />
      <ComponentRef Id="cmp_viewlba_tray_exe" />
      <ComponentRef Id="cmp_viewlba_installer_exe" />
      <ComponentRef Id="cmp_viewlba_ico" />
      <ComponentRef Id="cmp_runtime_bun_exe" />
      <ComponentRef Id="cmp_app_server_js" />
      <ComponentRef Id="cmp_config_dir" />
      <ComponentRef Id="cmp_db_dir" />
      <ComponentRef Id="cmp_media_dir" />
      <ComponentRef Id="cmp_backups_dir" />
      <ComponentRef Id="cmp_logs_dir" />
      <ComponentRef Id="cmp_credentials_dir" />
      <ComponentRef Id="cmp_run_dir" />
      <ComponentRef Id="cmp_cache_dir" />
      <ComponentRef Id="cmp_registry_root" />
    </Feature>

    <!-- Install sequence -->
    <InstallExecuteSequence>
      <Custom Action="ca_register_service" After="InstallFiles"
              Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="ca_start_service" After="ca_register_service"
              Condition="NOT Installed AND NOT REMOVE" />

      <Custom Action="ca_stop_service" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="ca_unregister_service" After="ca_stop_service"
              Condition="REMOVE=&quot;ALL&quot;" />

      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>
  </Package>
</Wix>
