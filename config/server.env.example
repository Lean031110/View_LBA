# ViewLBA Server — Environment Configuration Template
# ====================================================
#
# Copy this file to: C:\ProgramData\ViewLBA\config\server.env
#
# The service host (viewlba-service.exe) reads this file and passes the
# variables explicitly to each child process (app, realtime, stream).
#
# SECRETS:
#   AUTH_SECRET and REALTIME_TOKEN are generated by the installer using
#   installer/core/secrets.ts (cryptographic RNG). They are written to
#   server.env during first install and NEVER regenerated during upgrade.
#
# DO NOT commit real secrets to the repo. Use this template for reference.
# DO NOT put real values in argv, logs, or manifests.

# --- Application ---
PORT=3000
TIMEZONE=America/Havana
NODE_ENV=production

# --- Database ---
# SQLite path — absolute (Prisma resolves relative paths against CWD, not schema)
DATABASE_URL=file:C:/ProgramData/ViewLBA/data/db/custom.db

# --- Directories ---
MEDIA_DIR=C:/ProgramData/ViewLBA/data/media
BACKUP_DIR=C:/ProgramData/ViewLBA/data/backups
LOG_DIR=C:/ProgramData/ViewLBA/logs
DATA_DIR=C:/ProgramData/ViewLBA/data/store

# --- Realtime Service ---
REALTIME_PORT=3003
REALTIME_INTERNAL_PORT=3004

# --- Stream Service (node-media-server) ---
RTMP_PORT=1935
HTTP_FLV_PORT=8000
HTTP_FLV_BIND=127.0.0.1

# --- Secrets (GENERATED BY INSTALLER — do NOT hardcode) ---
# The installer generates these via installer/core/secrets.ts (randomBytes):
AUTH_SECRET=<GENERATED_BY_INSTALLER>
REALTIME_TOKEN=<GENERATED_BY_INSTALLER>

# --- Optional (uncomment to customize) ---
# LOGIN_RATE_LIMIT_IP_MAX=12
# LOG_RETENTION_DAYS=90
